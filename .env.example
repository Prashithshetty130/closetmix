# Environment variables template for Vestiq Digital Wardrobe & AI Stylist

# Database connection
# For local SQLite:
DATABASE_URL="file:./dev.db"
# For production PostgreSQL:
# DATABASE_URL="postgresql://user:password@host:5432/vestiq?schema=public"

# Auth JWT Secret (at least 32 characters)
JWT_SECRET="replace_with_a_secure_random_32_char_secret_in_production"

# AI Vision & Stylist Reasoning
# Either Google Gemini or OpenRouter (OpenRouter supports Gemini 2.5 Flash, Claude 3.5, GPT-4o)
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
